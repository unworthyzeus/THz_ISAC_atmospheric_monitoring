uctionDate","multiple":false,"typeClass":"primitive","value":"2023-09-11"},{"typeName":"productionPlace","multiple":true,"typeClass":"primitive","value":["IEMN UMR CNRS 8520, pôle CHOP, Avenue Poincaré Villeneuve d'Ascq , France"]},{"typeName":"distributor","multiple":true,"typeClass":"compound","value":[{"distributorName":{"typeName":"distributorName","multiple":false,"typeClass":"primitive","value":"Entrepôt Recherche Data Gouv"},"distributorURL":{"typeName":"distributorURL","multiple":false,"typeClass":"primitive","value":"https://entrepot.recherche.data.gouv.fr"},"distributorLogoURL":{"typeName":"distributorLogoURL","multiple":false,"typeClass":"primitive","value":"https://s3.fr-par.scw.cloud/rdg-portal/logos-macarons/Macarons%20Recherche%20Data%20Gouv_Entrep%C3%B4t.png"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"The data are time-domain traces recorded on a THz-TDS spectroscopy bench and concern calcite particles resuspended in dry nitrogen. These recordings, after FFT analysis, allow for the acquisition of the terahertz spectrum of calcite particles in aerosol form. Processing these data in the time domain, providing access to the signal amplitude and phase, enables the determination of the complex refractive indices of the materials. Acquisition was performed over a 1-meter optical path length using the Menlo Systems THz-TDS TeraSmart. The data were acquired trace by trace and then processed with the open-source software correct@TDS, available on GitHub: https://github.com/THzbiophotonics/Correct-TDS."},"dsDescriptionLanguage":{"typeName":"dsDescriptionLanguage","multiple":false,"typeClass":"controlledVocabulary","value":"English"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["English"]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Earth and 